---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
---

<Layout 
  title="Fotovoltická diagnostika, servis a monitoring FVE" 
  description="Nájdeme, čo bežná kontrola prehliadne. Profesionálna diagnostika, nezávislý audit, rýchly servis a priebežný monitoring fotovoltických elektrární na Slovensku."
>
  <main>
    <!-- 1. Hero Section -->
    <Hero />

    <!-- 2. Services Overview Section -->
    <ServiceCard />

    <!-- 4. Process Timeline Section -->
    <ProcessTimeline />

    <!-- 5. Bottom CTA Section -->
    <section class="cta-bottom-section">
      <div class="bg-glow bg-glow-orange" style="top: 10%; right: 10%; opacity: 0.15;"></div>
      <div class="bg-glow bg-glow-teal" style="bottom: 10%; left: 10%; opacity: 0.15;"></div>

      <div class="container">
        <div class="glass-card cta-box text-center">
          <span class="badge badge-orange">Zabezpečte si kontrolu</span>
          <h2>Nechajte slnko pracovať naplno</h2>
          <p>Nečakajte, kým sa chyba prejaví na ročnom vyúčtovaní. Objednajte si profesionálnu diagnostiku svojej fotovoltickej elektrárne ešte dnes.</p>
          <div class="cta-actions flex-center">
            <a href="/kontakt" class="btn btn-primary">Dohodnúť obhliadku</a>
            <a href="tel:+421900000000" class="btn btn-secondary">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:0.25rem;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              Zavolať
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Why Choose Us Styling */
  .why-us-section {
    background: var(--bg-deep);
    border-bottom: 1px solid var(--border-color);
  }

  .why-us-grid {
    align-items: center;
  }

  .why-us-features {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .why-feature-item {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .feature-icon-wrapper {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: hsla(180, 80%, 45%, 0.1);
    border: 1px solid hsla(180, 80%, 45%, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--secondary);
    flex-shrink: 0;
  }

  .feature-svg {
    width: 24px;
    height: 24px;
  }

  .why-feature-item:nth-child(even) .feature-icon-wrapper {
    background: hsla(35, 100%, 55%, 0.1);
    border-color: hsla(35, 100%, 55%, 0.2);
    color: var(--primary);
  }

  .feature-text h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .feature-text p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Visual Card simulation */
  .why-us-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .visual-card {
    max-width: 400px;
    width: 100%;
    border: 1px solid var(--border-color);
  }

  .visual-card-header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1rem;
    margin-bottom: 1rem;
  }

  .visual-chart-sim {
    background: #090d16;
    border-radius: 8px;
    border: 1px solid hsla(217, 30%, 15%, 0.8);
    padding: 1rem;
    margin-bottom: 1.25rem;
  }

  .chart-svg {
    width: 100%;
    height: auto;
  }

  .visual-card-desc h4 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .visual-card-desc p {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  /* CTA Bottom Section */
  .cta-bottom-section {
    background: var(--bg-dark);
    padding: 8rem 0;
  }

  .cta-box {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    border-color: var(--border-glow);
    box-shadow: 0 10px 40px rgba(255, 150, 0, 0.05);
  }

  .text-center {
    text-align: center;
  }

  .cta-box h2 {
    font-size: 2.5rem;
    max-width: 600px;
  }

  .cta-box p {
    font-size: 1.1rem;
    max-width: 580px;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .cta-actions {
    gap: 1.25rem;
    flex-wrap: wrap;
    width: 100%;
  }

  @media (max-width: 768px) {
    .cta-box {
      padding: 3rem 1.5rem;
    }
    
    .cta-box h2 {
      font-size: 2rem;
    }

    .cta-actions .btn {
      width: 100%;
    }
  }
</style>
