---
import Logo from './Logo.astro';
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="container footer-grid">
    <!-- Brand Info -->
    <div class="footer-col brand-col">
      <a href="/" class="footer-logo" aria-label="LVsun Domov">
        <Logo height={38} />
      </a>
      <p class="footer-tagline">
        Nájde to, čo bežná kontrola prehliadne — chybný panel, horúci spoj či zle zapojený string. Servis a priebežný monitoring na jednom mieste.
      </p>
    </div>

    <!-- Quick Navigation -->
    <div class="footer-col">
      <h3>Navigácia</h3>
      <ul>
        <li><a href="/">Domov</a></li>
        <li><a href="/sluzby">Služby</a></li>
        <li><a href="/o-nas">O nás</a></li>
        <li><a href="/kontakt">Kontakt</a></li>
      </ul>
    </div>

    <!-- Services Links -->
    <div class="footer-col">
      <h3>Naše Služby</h3>
      <ul>
        <li><a href="/sluzby#diagnostika">Diagnostika FVE</a></li>
        <li><a href="/sluzby#servis">Záručný a pozáručný servis</a></li>
        <li><a href="/sluzby#monitoring">Priebežný monitoring</a></li>
        <li><a href="/kontakt">Objednávka auditu</a></li>
      </ul>
    </div>

    <!-- Contact Info -->
    <div class="footer-col contact-col">
      <h3>Kontakt</h3>
      <ul class="contact-list">
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          <a href="tel:+421900000000">+421 900 000 000</a>
        </li>
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          <a href="mailto:info@lvsun.sk">info@lvsun.sk</a>
        </li>
      </ul>
      <div class="billing-details">
        <p>IČO: 00 000 000</p>
        <p>DIČ: SK0000000000</p>
      </div>
    </div>
  </div>

  <!-- Copyright -->
  <div class="footer-bottom">
    <div class="container footer-bottom-container">
      <p>&copy; {currentYear} LVsun. Všetky práva vyhradené.</p>
      <div class="footer-legal-links">
        <a href="#">Ochrana osobných údajov</a>
        <span class="divider">|</span>
        <a href="#">Obchodné podmienky</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    background: hsl(222, 47%, 2%);
    border-top: 1px solid var(--border-color);
    padding-top: 5rem;
    padding-bottom: 2rem;
    position: relative;
    z-index: 10;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  .footer-col h3 {
    font-size: 1.15rem;
    margin-bottom: 1.5rem;
    font-family: var(--font-title);
    color: var(--text-primary);
    position: relative;
    padding-bottom: 0.5rem;
  }

  .footer-col h3::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 30px;
    height: 2px;
    background: var(--secondary);
    box-shadow: 0 0 6px var(--secondary-glow);
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .footer-col a {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .footer-col a:hover {
    color: var(--text-primary);
    transform: translateX(4px);
    display: inline-block;
  }

  /* Brand Column */
  .brand-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: var(--transition-smooth);
  }

  .footer-logo:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .footer-tagline {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 320px;
  }

  /* Contact Column */
  .contact-list {
    margin-bottom: 1.25rem;
  }

  .contact-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }

  .contact-list svg {
    color: var(--secondary);
  }

  .billing-details {
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .billing-details p {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* Footer Bottom */
  .footer-bottom {
    border-top: 1px solid var(--border-color);
    padding-top: 2rem;
  }

  .footer-bottom-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-bottom p {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .footer-legal-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-legal-links a {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .footer-legal-links a:hover {
    color: var(--text-secondary);
  }

  .footer-legal-links .divider {
    color: var(--border-color);
    font-size: 0.85rem;
  }

  /* Responsive Design */
  @media (max-width: 968px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 576px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-bottom-container {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
