---

<section class="hero-section">
  <div class="container grid-2">
    <!-- Left Column: Content -->
    <div class="hero-content">
      <span class="badge badge-orange animate-pulse">Profesionálny servis FVE</span>
      <h1>
        Nájdeme to, čo bežná kontrola <span class="text-gradient">prehliadne</span>
      </h1>
      <p class="hero-desc">
        Chybný panel, degradovaný článok, horúci spoj či zle zapojený string — to všetko sú neviditeľné straty výkonu. Zabezpečíme precíznu diagnostiku, servis a monitoring fotovoltických elektrární na celom Slovensku.
      </p>
      
      <div class="hero-actions">
        <a href="/kontakt" class="btn btn-primary">Objednať diagnostiku</a>
        <a href="#ako-to-funguje" class="btn btn-secondary">Ako to funguje &darr;</a>
      </div>

      <!-- Quick Metrics -->
      <div class="hero-metrics">
        <div class="metric-card glass-panel">
          <div class="metric-value">až 30%</div>
          <div class="metric-label">možná strata výkonu pri neodhalených chybách</div>
        </div>
        <div class="metric-card glass-panel">
          <div class="metric-value">2 - 4 h</div>
          <div class="metric-label">priemerný čas dôkladného merania na mieste</div>
        </div>
      </div>
    </div>

    <!-- Right Column: Animated Scan Card -->
    <div class="hero-visual">
      <div class="scan-card" aria-hidden="true">
        <div class="scan-head">
          <span>LIVE SCAN · POLE A</span>
          <b>8 × 3 moduly</b>
        </div>
        <div class="panel-grid">
          <div class="scanline"></div>
          <div class="cell"></div><div class="cell"></div><div class="cell f1 fault"></div><div class="cell"></div><div class="cell"></div><div class="cell"></div><div class="cell"></div><div class="cell"></div>
          <div class="cell"></div><div class="cell"></div><div class="cell"></div><div class="cell"></div><div class="cell f2 fault"></div><div class="cell"></div><div class="cell"></div><div class="cell"></div>
          <div class="cell"></div><div class="cell"></div><div class="cell"></div><div class="cell"></div><div class="cell"></div><div class="cell"></div><div class="cell f3 fault"></div><div class="cell"></div>
        </div>
        <div class="scan-readouts">
          <span class="r1">Modul C1 · 68 °C horúci bod</span>
          <span class="r2">String 2 · −12,4 % výkon</span>
          <span class="r3">Modul G3 · uvoľnený konektor</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Hero layout ── */
  .hero-section {
    padding-top: 10rem;
    padding-bottom: 7rem;
    position: relative;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    z-index: 10;
  }

  .hero-content h1 {
    font-size: 3.75rem;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .text-gradient {
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-desc {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 580px;
  }

  .hero-actions {
    display: flex;
    gap: 1.25rem;
    margin-top: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .hero-metrics {
    display: flex;
    gap: 1.5rem;
    width: 100%;
    max-width: 550px;
  }

  .metric-card {
    flex: 1;
    padding: 1.5rem;
    border-radius: 14px;
    border: 1px solid var(--border-color);
  }

  .metric-value {
    font-family: var(--font-title);
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--primary);
    line-height: 1;
    margin-bottom: 0.5rem;
    text-shadow: 0 0 15px var(--primary-glow);
  }

  .metric-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    z-index: 10;
  }

  /* ── Scan Card ── */
  .scan-card {
    width: 100%;
    max-width: 480px;
    background: hsla(220, 30%, 8%, 0.85);
    border: 1px solid hsla(140, 60%, 35%, 0.25);
    border-radius: 18px;
    padding: 1.5rem;
    box-shadow: 0 24px 60px rgba(0,0,0,0.55), 0 0 0 1px hsla(140,50%,30%,0.1);
    backdrop-filter: blur(12px);
    font-family: 'Space Mono', 'Courier New', monospace;
  }

  /* header row */
  .scan-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: hsla(140, 60%, 55%, 0.75);
    margin-bottom: 1.1rem;
  }
  .scan-head b {
    color: var(--primary);
    font-weight: 700;
  }

  /* ── Panel grid ── */
  .panel-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 5px;
    background: hsla(140, 25%, 6%, 0.9);
    border-radius: 10px;
    padding: 10px;
    overflow: hidden;
  }

  .cell {
    aspect-ratio: 1 / 1.1;
    border-radius: 4px;
    background: hsla(140, 30%, 14%, 0.8);
    border: 1px solid hsla(140, 30%, 22%, 0.3);
    position: relative;
    transition: background 0.3s;
  }

  /* fault glow blobs */
  .fault::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 4px;
    pointer-events: none;
  }

  /* f1 = amber/yellow — rovnaká farba ako r1 badge */
  .f1 { background: hsla(45, 100%, 42%, 0.25); border-color: hsla(45,100%,60%,0.45); }
  .f1::after { box-shadow: 0 0 22px 8px hsla(45,100%,60%,0.40); animation: pulse-f1 2.4s ease-in-out infinite; }

  /* f2 = modrá/cyan — rovnaká farba ako r2 badge (hsl 200) */
  .f2 { background: hsla(200, 80%, 40%, 0.22); border-color: hsla(200,80%,60%,0.40); }
  .f2::after { box-shadow: 0 0 20px 7px hsla(200,80%,60%,0.35); animation: pulse-f2 3.1s ease-in-out infinite; }

  /* f3 = biela/strieborná — rovnaká farba ako r3 badge */
  .f3 { background: hsla(0, 0%, 90%, 0.12); border-color: hsla(0,0%,100%,0.40); }
  .f3::after { box-shadow: 0 0 18px 6px hsla(0,0%,100%,0.25); animation: pulse-f3 2.7s ease-in-out infinite; }

  @keyframes pulse-f1 {
    0%,100% { opacity: 0.55; transform: scale(0.92); }
    50%      { opacity: 1;    transform: scale(1.12); }
  }
  @keyframes pulse-f2 {
    0%,100% { opacity: 0.45; transform: scale(0.88); }
    50%      { opacity: 0.95; transform: scale(1.15); }
  }
  @keyframes pulse-f3 {
    0%,100% { opacity: 0.50; transform: scale(0.90); }
    50%      { opacity: 1;    transform: scale(1.10); }
  }

  /* ── Scan line sweep ── */
  .scanline {
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 100%;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      hsla(140, 80%, 55%, 0.0) 10%,
      hsla(140, 80%, 65%, 0.85) 50%,
      hsla(140, 80%, 55%, 0.0) 90%,
      transparent 100%
    );
    filter: blur(1.5px);
    box-shadow: 0 0 14px 4px hsla(140,80%,55%,0.5);
    animation: scanline-sweep 5.5s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    pointer-events: none;
    z-index: 5;
    border-radius: 2px;
  }

  @keyframes scanline-sweep {
    0%   { left: 0%;    opacity: 0; }
    5%   { opacity: 1; }
    95%  { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }

  /* ── Readout badges ── */
  .scan-readouts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .scan-readouts span {
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px solid;
    /* vždy viditelné, dim stav */
    opacity: 0.3;
    transition: opacity 0.15s, box-shadow 0.15s;
  }

  /*
    Scanline trvanie: 5.5s
    Grid: 8 stĺpce
    f1 = stĺpec 3 (index 2)  → pozicia ~31% → rozsvieti sa v 31-41%
    f2 = stĺpec 5 (index 4)  → pozicia ~56% → rozsvieti sa v 56-66%
    f3 = stĺpec 7 (index 6)  → pozicia ~81% → rozsvieti sa v 81-91%
  */

  .r1 {
    color: hsl(45,100%,65%);
    border-color: hsla(45,100%,55%,0.35);
    background: hsla(45,100%,50%,0.08);
    animation: badge-r1 5.5s ease-in-out infinite;
  }
  .r2 {
    color: hsl(200,80%,65%);
    border-color: hsla(200,80%,55%,0.35);
    background: hsla(200,80%,50%,0.08);
    animation: badge-r2 5.5s ease-in-out infinite;
  }
  .r3 {
    color: hsl(0,0%,90%);
    border-color: hsla(0,0%,100%,0.25);
    background: hsla(0,0%,100%,0.06);
    animation: badge-r3 5.5s ease-in-out infinite;
  }

  /* f1 ~ 31% pozicia v gridd */
  @keyframes badge-r1 {
    0%,  26% { opacity: 0.28; box-shadow: none; }
    31%       { opacity: 1;    box-shadow: 0 0 12px 2px hsla(45,100%,55%,0.45); }
    41%       { opacity: 1;    box-shadow: 0 0 12px 2px hsla(45,100%,55%,0.45); }
    46%, 100% { opacity: 0.28; box-shadow: none; }
  }

  /* f2 ~ 56% pozicia v gride */
  @keyframes badge-r2 {
    0%,  51% { opacity: 0.28; box-shadow: none; }
    56%       { opacity: 1;    box-shadow: 0 0 12px 2px hsla(200,80%,55%,0.45); }
    66%       { opacity: 1;    box-shadow: 0 0 12px 2px hsla(200,80%,55%,0.45); }
    71%, 100% { opacity: 0.28; box-shadow: none; }
  }

  /* f3 ~ 81% pozicia v gride */
  @keyframes badge-r3 {
    0%,  76% { opacity: 0.28; box-shadow: none; }
    81%       { opacity: 1;    box-shadow: 0 0 12px 2px hsla(0,0%,100%,0.35); }
    91%       { opacity: 1;    box-shadow: 0 0 12px 2px hsla(0,0%,100%,0.35); }
    96%, 100% { opacity: 0.28; box-shadow: none; }
  }

  /* ── Responsive ── */
  @media (max-width: 968px) {
    .hero-section { padding-top: 8rem; padding-bottom: 5rem; }
    .hero-content h1 { font-size: 2.85rem; }
    .hero-metrics { max-width: 100%; }
  }

  @media (max-width: 576px) {
    .hero-content h1 { font-size: 2.35rem; }
    .hero-actions { width: 100%; }
    .hero-actions .btn { width: 100%; }
    .hero-metrics { flex-direction: column; gap: 1rem; }
    .scan-card { max-width: 100%; }
  }
</style>
