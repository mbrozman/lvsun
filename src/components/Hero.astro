---
---

<section class="hero-section">
  <div class="container grid-2">
    <!-- Left Column: Content -->
    <div class="hero-content">
      <span class="badge badge-orange animate-pulse">Profesionálny servis FVE</span>
      <h1>
        Nájdeme to, čo bežná kontrola <span class="text-gradient">prehliadne</span>
      </h1>
      <p class="hero-desc">
        Chybný panel, degradovaný článok, horúci spoj či zle zapojený string — to všetko sú neviditeľné straty výkonu. Zabezpečíme precíznu diagnostiku, servis a monitoring fotovoltických elektrární na celom Slovensku.
      </p>
      
      <div class="hero-actions">
        <a href="/kontakt" class="btn btn-primary">Objednať diagnostiku</a>
        <a href="#ako-to-funguje" class="btn btn-secondary">Ako to funguje &darr;</a>
      </div>

      <!-- Quick Metrics -->
      <div class="hero-metrics">
        <div class="metric-card glass-panel">
          <div class="metric-value">až 30%</div>
          <div class="metric-label">možná strata výkonu pri neodhalených chybách</div>
        </div>
        <div class="metric-card glass-panel">
          <div class="metric-value">2 - 4 h</div>
          <div class="metric-label">priemerný čas dôkladného merania na mieste</div>
        </div>
      </div>
    </div>

    <!-- Right Column: Premium High-Tech Scan Animation -->
    <div class="hero-visual">
      <div class="scanner-container glass-card">
        <!-- Interactive Tech Panel Layout -->
        <div class="scanner-header">
          <span class="scanner-dot"></span>
          <span class="scanner-title font-title">SYSTEM STATUS: ACTIVE SCAN</span>
        </div>
        
        <!-- SVG Interactive Solar Panel & Scan Beam -->
        <div class="scanner-screen">
          <svg viewBox="0 0 400 300" fill="none" xmlns="http://www.w3.org/2000/svg" class="scanner-svg">
            <!-- Grid background -->
            <defs>
              <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
                <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(255,255,255,0.02)" stroke-width="1"/>
              </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#grid)" />
            
            <!-- Solar Panel Isometric grid -->
            <g class="solar-panel-group">
              <!-- Base Outline -->
              <polygon points="60,200 200,80 340,200 200,260" stroke="rgba(255, 255, 255, 0.15)" stroke-width="2" fill="rgba(30, 41, 59, 0.4)"/>
              
              <!-- Individual Solar Cells Grid & Heatspots (Simulated Thermal Imaging) -->
              <!-- Top Quadrant -->
              <polygon points="200,80 130,140 200,170 270,140" stroke="rgba(255,255,255,0.1)" stroke-width="1" fill="rgba(15, 23, 42, 0.6)"/>
              <!-- Heatspot (Hot Cell) -->
              <circle cx="200" cy="140" r="14" fill="rgba(239, 68, 68, 0.4)" filter="blur(6px)" class="thermal-hotspot"></circle>
              <circle cx="200" cy="140" r="4" fill="var(--primary)" class="thermal-center"></circle>
              
              <!-- Left Quadrant -->
              <polygon points="130,140 60,200 130,230 200,170" stroke="rgba(255,255,255,0.1)" stroke-width="1" fill="rgba(15, 23, 42, 0.6)"/>
              
              <!-- Right Quadrant -->
              <polygon points="270,140 200,170 270,230 340,200" stroke="rgba(255,255,255,0.1)" stroke-width="1" fill="rgba(15, 23, 42, 0.6)"/>
              <!-- Heatspot (Micro-crack) -->
              <circle cx="280" cy="180" r="18" fill="rgba(180, 80, 45, 0.3)" filter="blur(8px)" class="thermal-hotspot-2"></circle>
              
              <!-- Bottom Quadrant -->
              <polygon points="200,170 130,230 200,260 270,230" stroke="rgba(255,255,255,0.1)" stroke-width="1" fill="rgba(15, 23, 42, 0.6)"/>
            </g>

            <!-- Diagnostic Scan Line (Laser Sweep) -->
            <g class="laser-group">
              <line x1="50" y1="120" x2="350" y2="120" stroke="var(--secondary)" stroke-width="2" class="laser-beam" />
              <!-- Glow of the laser -->
              <line x1="50" y1="120" x2="350" y2="120" stroke="var(--secondary)" stroke-width="8" opacity="0.3" class="laser-beam-glow" />
            </g>

            <!-- Holographic UI Overlays -->
            <text x="70" y="50" fill="var(--secondary)" font-family="monospace" font-size="10" opacity="0.8">SCAN RATE: 100%</text>
            <text x="70" y="70" fill="var(--text-secondary)" font-family="monospace" font-size="10" opacity="0.6">MODEL: IV-CURVE 3.1</text>
            
            <text x="250" y="270" fill="var(--primary)" font-family="monospace" font-size="10" opacity="0.8">HOTSPOT DETECTED</text>
            <circle cx="235" cy="267" r="3" fill="var(--primary)"></circle>
          </svg>
        </div>

        <!-- System Stats Footer Inside Visual -->
        <div class="scanner-footer">
          <div class="footer-stat">
            <span class="stat-lbl">RESOLUTION</span>
            <span class="stat-val">384x288 px (IR)</span>
          </div>
          <div class="footer-stat">
            <span class="stat-lbl">TEMP RANGE</span>
            <span class="stat-val">-20°C ~ 550°C</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: 10rem;
    padding-bottom: 7rem;
    position: relative;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    z-index: 10;
  }

  .hero-content h1 {
    font-size: 3.75rem;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .text-gradient {
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-desc {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 580px;
  }

  .hero-actions {
    display: flex;
    gap: 1.25rem;
    margin-top: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .hero-metrics {
    display: flex;
    gap: 1.5rem;
    width: 100%;
    max-width: 550px;
  }

  .metric-card {
    flex: 1;
    padding: 1.5rem;
    border-radius: 14px;
    border: 1px solid var(--border-color);
  }

  .metric-value {
    font-family: var(--font-title);
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--primary);
    line-height: 1;
    margin-bottom: 0.5rem;
    text-shadow: 0 0 15px var(--primary-glow);
  }

  .metric-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  /* Right Column: Scan Animation styling */
  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    z-index: 10;
  }

  .scanner-container {
    width: 100%;
    max-width: 460px;
    padding: 1.5rem;
    border: 1px solid var(--border-color);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }

  .scanner-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1rem;
    margin-bottom: 1.25rem;
  }

  .scanner-dot {
    width: 8px;
    height: 8px;
    background: var(--error);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--error);
    animation: pulse-glow 1.5s infinite;
  }

  .scanner-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: 0.1em;
  }

  .scanner-screen {
    background: #090d16;
    border-radius: 10px;
    border: 1px solid hsla(217, 30%, 20%, 0.7);
    overflow: hidden;
    position: relative;
  }

  .scanner-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .scanner-footer {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
    margin-top: 1.25rem;
  }

  .footer-stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-lbl {
    font-size: 0.65rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .stat-val {
    font-family: monospace;
    font-size: 0.85rem;
    color: var(--secondary);
    font-weight: 700;
  }

  /* Scan Animations CSS */
  @keyframes scan-sweep {
    0% { transform: translateY(-40px); }
    50% { transform: translateY(180px); }
    100% { transform: translateY(-40px); }
  }

  @keyframes pulse-hotspot {
    0%, 100% { transform: scale(1); opacity: 0.4; }
    50% { transform: scale(1.15); opacity: 0.85; }
  }

  .laser-beam, .laser-beam-glow {
    animation: scan-sweep 6s ease-in-out infinite;
    transform-origin: center;
  }

  .thermal-hotspot, .thermal-hotspot-2 {
    animation: pulse-hotspot 2s ease-in-out infinite;
    transform-origin: 200px 140px;
  }
  
  .thermal-hotspot-2 {
    transform-origin: 280px 180px;
    animation-delay: -1s;
  }

  /* Responsive Design */
  @media (max-width: 968px) {
    .hero-section {
      padding-top: 8rem;
      padding-bottom: 5rem;
    }

    .hero-content h1 {
      font-size: 2.85rem;
    }

    .hero-metrics {
      max-width: 100%;
    }
  }

  @media (max-width: 576px) {
    .hero-content h1 {
      font-size: 2.35rem;
    }

    .hero-actions {
      width: 100%;
    }

    .hero-actions .btn {
      width: 100%;
    }

    .hero-metrics {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
